    "border": "#E2E8F0",
    "ink": "#0F172A",
    "text": "#334155",
    "muted": "#64748B",
    "faint": "#94A3B8",
    "primary": "#1D4ED8",
    "primary_hover": "#1E40AF",
    "primary_off": "#9DB4EE",
    "tint": "#E3EDFF",
    "tint_border": "#C7D8F8",
    "select": "#EAF1FF",
    "hover": "#F5F8FE",
    "panel": "#F4F7FC",
    "head": "#F1F5FB",
    "track": "#E2E8F0",
    "warn_bg": "#FEF3D6",
    "warn_text": "#B45309",
    "bad_bg": "#FDE4E4",
    "bad_text": "#B91C1C",
